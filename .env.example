# TrainingEdge — 环境变量配置
# 复制此文件为 .env 并填入实际值

# ── 数据库与存储 ──
# macOS 本地开发推荐放在 OneDrive 之外（避免 SQLite 锁冲突 + 同步触发 reload）
# TRAININGEDGE_DB_PATH=~/Library/Application Support/TrainingEdge/training_edge.db
# TRAININGEDGE_FIT_DIR=~/Library/Application Support/TrainingEdge/fit_files
# TRAININGEDGE_LOG_FILE=~/Library/Application Support/TrainingEdge/logs/training_edge.log
# GARMINTOKENS=~/Library/Application Support/TrainingEdge/tokens
TRAININGEDGE_DB_PATH=/data/training_edge.db
TRAININGEDGE_FIT_DIR=/data/fit_files
TRAININGEDGE_LOG_FILE=/data/training_edge.log
TRAININGEDGE_PORT=8420

# ── 运动员参数 ──
TRAININGEDGE_FTP=229
TRAININGEDGE_MAX_HR=192
TRAININGEDGE_RESTING_HR=42

# ── Garmin 同步 ──
GARMIN_EMAIL=your-email@example.com
GARMIN_PASSWORD=your-garmin-password
GARMINTOKENS=/data/tokens
# 如果您的账号在中国区 (garmin.cn)，请设置为 true
GARMIN_IS_CN=false

# ── 本地模式：复用 Hermes 的 garmin.db ──
# 设置后 wellness 同步直接读 garmin.db，不再调 Garmin API
# GARMIN_DB_PATH=../garmin.db
# GARMINTOKENS=../state/garmin-tokens
# GARMIN_IS_CN=true
# 关闭后台自动 Garmin API 同步（Hermes 已负责）
# TRAININGEDGE_SYNC_INTERVAL_HOURS=0

# ── 访问控制（公网部署必填！）──
TRAININGEDGE_PASSWORD=your-secure-password-here
TRAININGEDGE_SESSION_SECRET=random-hex-string-here

# ── LLM (可选，也可在设置页配置) ──
# 从 https://openrouter.ai/keys 获取
OPENROUTER_API_KEY=
# OPENROUTER_PROXY=socks5://vps-ip:1080

# API 访问密钥（留空自动生成）
TRAININGEDGE_API_KEY=

# ── 时区 ──
TZ=Asia/Shanghai
